{
	// Cloudflare Worker with static assets (Workers Builds on branch `simple`).
	// Build command: `npm run build` (astro build → ./dist), deploy: `npx wrangler deploy`.
	// The name must match the Worker in the dashboard, or Workers Builds refuses to deploy.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "danielredacted-github-io",
	"main": "worker.js",
	"compatibility_date": "2025-11-02",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	// worker.js → functions/api/form.js stores contact messages here (schema.sql).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "danielromo-forms",
			"database_id": "c224e39f-1582-48bd-ae0a-8c2ebdd03ead"
		}
	]
}
