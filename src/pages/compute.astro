      <!-- known mesh nodes, same system as the mesh-radio diagram below: sun
           badge on my contacts, no always-on wave arcs. tagged here because the
           map labels every contact it draws; the diagram stays label-free -->
      {mapMeshNodes.map((n, i) => !n.mine && (
        <g class:list={['mesh', n.contact && 'contact']}>
