---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import AltPair from '../components/AltPair.astro';
import Icon from '../components/Icon.astro';
import { models, toolGroups, hardware, runtime, network, alternatives } from '../data/tools.js';
import { contours, coast } from '../data/terrain.js';
import { meshContours, meshIndexStep } from '../data/mesh-terrain.js';
import { satContours, satIndexStep } from '../data/sat-terrain.js';

// Look marks up by label rather than by position: tools.js is generated, and inserting an
// entry used to silently rebind the wrong logo here. A typo now fails the build instead.
const all = [...hardware, ...runtime, ...network, ...toolGroups.flatMap((g) => g.tools), ...models];
const mark = (label) => {
  const found = all.find((t) => t.label === label);
  if (!found) throw new Error(`unknown mark: ${label}`);
  return found;
};
const pair = (openLabel) => {
  const found = alternatives.find((a) => a.open.label === openLabel);
  if (!found) throw new Error(`unknown pair: ${openLabel}`);
  return found;
};

// No clean vector mark exists for either: CWOP's only logo is a dated raster badge, and
// TTN's marketing site has no fetchable brand SVG. Text-only badges, same chip styling.
const cwop = { label: 'CWOP', url: 'https://www.wxqa.com/' };
const ttn = { label: 'The Things Network', url: 'https://www.thethingsnetwork.org' };

// Neither icon CDN carries a mark for any of these (simple-icons 404s on coturn,
// headscale, powerdns), so they take the same text-only chips: Mark.astro skips
// the <svg> when item.svg is absent.
const coturn = { label: 'coturn', url: 'https://github.com/coturn/coturn' };
const headscale = { label: 'Headscale', url: 'https://headscale.net' };
const knot = { label: 'Knot DNS', url: 'https://www.knot-dns.cz' };
const powerdns = { label: 'PowerDNS', url: 'https://www.powerdns.com' };
const bind = { label: 'BIND 9', url: 'https://www.isc.org/bind/' };
const unbound = { label: 'Unbound', url: 'https://nlnetlabs.nl/projects/unbound/' };
const chrony = { label: 'chrony', url: 'https://chrony-project.org' };
const gpsd = { label: 'gpsd', url: 'https://gpsd.io' };
const readsb = { label: 'readsb', url: 'https://github.com/wiedehopf/readsb' };
const aiscatcher = { label: 'AIS-catcher', url: 'https://github.com/jvde-github/AIS-catcher' };

// The contents nav, the chapter.section numbers and every section heading come
// off this one list, so the three cannot drift apart. Ids are permanent: they
// are the page's anchors and outside links point at them, so a section keeps
// its id when its title changes.
const chapters = [
  {
    title: 'Radio, satellite, broadcast',
    sections: [
      { id: 'mesh-radio', title: 'mesh radio', sub: 'private and public, no carrier' },
      { id: 'amateur-relay', title: 'amateur radio relay', sub: 'open, in the clear' },
      { id: 'satellite-downlink', title: 'satellite downlinks', sub: 'receive only' },
      { id: 'ota-tv', title: 'over-the-air TV', sub: 'broadcast, unmetered' },
      { id: 'beacons', title: 'beacon receivers', sub: 'aircraft and vessels' },
      { id: 'gnss', title: 'time and position', sub: 'a clock from satellites' },
    ],
  },
  {
    title: 'Sensing',
    sections: [
      { id: 'weather-station', title: 'weather station', sub: 'sensors and telemetry' },
      { id: 'smart-security', title: 'cameras', sub: 'recording and local inference' },
    ],
  },
  {
    title: 'Compute, models, storage',
    sections: [
      { id: 'ai-compute', title: 'AI compute', sub: 'the machine and its power' },
      { id: 'nas', title: 'NAS', sub: 'storage on the network' },
      { id: 'open-weights', title: 'open weight models', sub: 'what it serves' },
    ],
  },
  {
    title: 'Private paths in and out',
    sections: [
      { id: 'vpn', title: 'VPN', sub: 'the way in and out' },
      { id: 'tor', title: 'Tor', sub: 'anonymity and hidden services' },
      { id: 'stun-server', title: 'STUN server', sub: 'a path through NAT' },
      { id: 'dynamic-dns', title: 'DNS', sub: "your name, and everyone else's" },
    ],
  },
  {
    title: 'Sharing',
    sections: [
      { id: 'community-research', title: 'community research', sub: 'the surplus, and who gets it' },
    ],
  },
];
const byId = {};
chapters.forEach((c, ci) =>
  c.sections.forEach((s, si) => {
    byId[s.id] = { ...s, n: `${ci + 1}.${si + 1}`, chapter: si === 0 ? `${ci + 1} · ${c.title}` : '' };
  }),
);
// Same contract as mark(): an unknown id fails the build instead of rendering an
// empty heading. The chapter eyebrow rides along on the first section of each
// chapter, so no chapter markup is hand-placed in the body.
// ponytail: an HTML string through set:html, not a component. A component would
// render these elements outside this file and lose Astro's scoped-style stamp,
// so `.marks > p` and `section[id]` would quietly stop matching.
const head = (id) => {
  const s = byId[id];
  if (!s) throw new Error(`unknown section: ${id}`);
  return (
    (s.chapter ? `<p class="label chapter">${s.chapter}</p>` : '') +
    `<div class="sec-head"><h2>${s.title}</h2><span class="idx"><b>${s.n}</b> · ${s.sub}</span></div>`
  );
};

// Field-log sample data. Public tier withholds identities, counts, and timing:
// that detailed data is gated behind the node's API. Species are what the
// classifier plausibly hears around a coastal Southern California node; * marks
// the backyard aviary residents. AIR shows make/model, resolved locally by
// matching the beacon's hex against the registry DB every receiver bundles
// (standard practice); the hex/callsign identity itself stays API-tier. SEA
// type and length come straight from the AIS static data report, which really
// does broadcast them; ORBIT stays generic because satellite identity is
// inferred from frequency and orbit, not carried in the downlink.
const birds = [
  'Zebra Finch *',
  'Society Finch *',
  "Anna's Hummingbird",
  'American Crow',
  'Western Gull',
  'California Scrub-Jay',
  'Mourning Dove',
  'California Gnatcatcher',
  'House Finch',
  'California Towhee',
  'Northern Mockingbird',
  'Song Sparrow',
  'Black Phoebe',
  'Lesser Goldfinch',
  "Bewick's Wren",
  'Wrentit',
  'Acorn Woodpecker',
  'Killdeer',
];
const contacts = {
  AIR: [
    'Boeing 737-800',
    'Airbus A321neo',
    'Boeing 777-300ER',
    'Cessna 172 Skyhawk',
    'Cirrus SR22',
    'Gulfstream G550',
    'Pilatus PC-12',
    'Robinson R44',
    'Lockheed C-130 Hercules',
  ],
  SEA: ['Coaster · 89m', 'Fishing vessel · 24m', 'Sailing vessel · 14m'],
  ORBIT: ['Weather satellite', 'Amateur radio satellite', 'Space station'],
};

// mesh-radio diagram nodes, one source for the SVG and the traffic script.
// contact = my network (solar, sun badge, darker glyph); the rest are other
// radios in the community. adjacency is derived from RF range.
const meshNodes = [
  { x: 210, y: 250, contact: true },
  { x: 490, y: 215, contact: true },
  { x: 760, y: 295, mine: true },
  { x: 880, y: 440 },
  { x: 40, y: 140, contact: true },
  { x: 330, y: 45 },
  { x: 640, y: 75, contact: true },
  { x: 480, y: 330 },
  { x: 55, y: 420 },
  { x: 330, y: 420 },
  { x: 640, y: 455, contact: true },
  { x: 915, y: 165, contact: true },
  { x: 965, y: 340 },
];

// the same mesh, sparser, on the field map: my node, 5 contacts and 3
// strangers. the two indirect contacts chain off the same direct one, so the
// far end of my own network sits a full three hops out. some stranger pairs
// are out of range of each other too, and cross my network's relays to talk.
// positions are on land (checked against the terrain contours).
const mapMeshNodes = [
  { x: 640, y: 420, mine: true },
  { x: 500, y: 560, contact: true, tag: '!a4f2' },  // direct
  { x: 430, y: 380, contact: true, tag: '!e09b' },  // direct
  { x: 900, y: 330, contact: true, tag: '!b81d' },  // direct
  { x: 1080, y: 500, contact: true, tag: '!5c60' }, // 2 hops, via !b81d
  { x: 1265, y: 675, contact: true, tag: '!2f94' }, // 3 hops, via !5c60
  { x: 880, y: 560, tag: '!77c1' },
  { x: 950, y: 720, tag: '!3d5a' },
  { x: 180, y: 390, tag: '!d073' },
];

// every pair in RF range is linked on the public channel; pairs inside my
// network additionally share the private one, drawn instead (it sits on top)
const linksFor = (nodes, range) =>
  nodes.flatMap((a, i) =>
    nodes.slice(i + 1)
      .filter((b) => Math.hypot(a.x - b.x, a.y - b.y) <= range)
      .map((b) => ({
        x1: a.x, y1: a.y, x2: b.x, y2: b.y,
        priv: !!(a.contact || a.mine) && !!(b.contact || b.mine),
      })),
  );
const meshLinks = linksFor(meshNodes, 290);
const mapMeshLinks = linksFor(mapMeshNodes, 300);

// satellite-downlink diagram (03). A continental frame, unlike anything else on
// this page: gen-sat-terrain.mjs draws 30 degrees of latitude, so one viewBox
// unit is ~5.96 km and real pass geometry can be drawn rather than implied.
// Checked before shipping: the horizon ring is 402u, and of the four passes one
// crosses 176 km from the node (77 degrees elevation), two are middling at 22
// and 15 degrees, and the westernmost stays 3094 km out and never comes into
// range at all.
const SAT_KM_PER_UNIT = (30 * 111.32) / 560; // generator LAT_SPAN over viewBox height
const SAT_HORIZON_KM = 2400; // ~7 degree elevation mask for an 850 km orbit
// one radius does double duty, which is the mechanism: the ground distance over
// which the node can hear a satellite is the same distance over which that
// satellite's broadcast reaches the ground
const satRingR = SAT_HORIZON_KM / SAT_KM_PER_UNIT;
const satNode = { x: 620, y: 235 };
// Four passes of one sun-synchronous orbit, walking west each time around, which
// is how a polar orbiter eventually sees the whole planet. They are parallel by
// construction rather than by choice: an ascending track would have to cross the
// descending ones, and crossing means imaging the same ground twice, which is
// the one thing this drawing must not do. So all four share a direction and the
// spacing is derived below, not chosen.
const SAT_DIR = { x: -140, y: 640 };
const satDirLen = Math.hypot(SAT_DIR.x, SAT_DIR.y);
const satU = { x: SAT_DIR.x / satDirLen, y: SAT_DIR.y / satDirLen };
const satN = { x: satU.y, y: -satU.x }; // across the track
// the frame's whole extent across the tracks, cut into four equal strips: the
// swaths then tile it exactly, no overlap and no bare ground. this is what fixes
// the swath width, which is why it is ~1635 km and not a particular instrument's
// number. a real orbit walks further than this between passes; the spacing here
// is drawn to tile the frame, and the prose claims nothing narrower.
const satFramePerp = [[0, 0], [1000, 0], [0, 560], [1000, 560]].map(([x, y]) => x * satN.x + y * satN.y);
const satPerpMin = Math.min(...satFramePerp);
const satSwathW = (Math.max(...satFramePerp) - satPerpMin) / 4;
const SAT_SWATH_KM = satSwathW * SAT_KM_PER_UNIT;
// park = where each satellite sits in the static frame under reduced motion.
// staggered so the frozen mosaic shows four different ages at once.
const satTracks = [0.15, 0.6, 0.4, 0.85].map((park, k) => {
  const c = satPerpMin + (3.5 - k) * satSwathW; // east to west, in pass order
  const endAt = (y) => {
    const a = (y - c * satN.y) / satU.y;
    return { x: c * satN.x + a * satU.x, y };
  };
  const p1 = endAt(-40);
  const p2 = endAt(600);
  return { x1: p1.x, y1: p1.y, x2: p2.x, y2: p2.y, park };
});
const satParks = satTracks.map((t) => ({
  x: t.x1 + (t.x2 - t.x1) * t.park,
  y: t.y1 + (t.y2 - t.y1) * t.park,
}));
// The imager sweeps its swath the whole way around, and that sweep is what
// paints the terrain: the map has no ground on it until a pass lays some down.
// Each strip then ages continuously from the moment it is finished until its own
// orbit comes back to redraw it, so at any instant the four strips are at four
// different ages and the map reads as ground that keeps having to be re-acquired.
// What the node actually *received* stays a separate and stricter claim: the
// receive flash is gated on the ring, so the westernmost pass lays down terrain
// without the node ever flashing, which is the honest difference between what
// flew over and what landed.
const satGeom = satTracks.map((t) => {
  const len = Math.hypot(t.x2 - t.x1, t.y2 - t.y1);
  return {
    len,
    angleDeg: (Math.atan2(t.y2 - t.y1, t.x2 - t.x1) * 180) / Math.PI,
    // how much swath each satellite has laid down by the time it reaches its
    // parked spot, so the static frame is a mosaic caught mid-build
    staticW: t.park * len,
  };
});
// Coordinate furniture: a 5 degree graticule, and the one layer on this surface
// that never moves. The frame is 30 degrees of latitude over 560 units, so a
// parallel every 5 degrees is one every 93.3 units, and the generator makes
// longitude km-true at the frame's centre latitude, so meridians at that same
// unit spacing are a constant longitude interval as well. Which interval, and
// which parallels these are, go unstated: the frame's coordinates are withheld
// from the committed data, so the lines carry no labels and land on no round
// numbers. The spacing is real; the position is not disclosed.
const SAT_GRAT_DEG = 5;
const satGratStep = (SAT_GRAT_DEG / 30) * 560;
const satGratX = Array.from({ length: Math.ceil(1000 / satGratStep) - 1 }, (_, i) => (i + 1) * satGratStep);
const satGratY = Array.from({ length: Math.ceil(560 / satGratStep) - 1 }, (_, i) => (i + 1) * satGratStep);

---

<Base
  title="my private/community node · Daniel Romo"
  description="A design document for a self-hosted node: the radio links, sensors, local power, AI compute, and the reasoning behind each piece."
>
  <div class="hero-wrap">
  <div class="hud-identity">
    <p class="label eyebrow">FIELD DIAGRAM · COMMUNITY NODE</p>
    <h1>My Private/Community Node</h1>
  </div>
  <section class="fieldmap" aria-label="Live field diagram of the node and its surroundings">
    <svg class="map" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <!-- Daniel's Node.svg (public/images/Node.svg) inlined with currentColor
             strokes so the receive-pulse can recolor it; an <image> ref could not -->
        <g id="node-icon" transform="translate(3.025, 3.1)" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path class="signal" d="M4.9,16.1 C1,12.2 1,5.8 4.9,1.9" />
          <path class="signal" d="M7.8,4.7 C5.848,6.722 5.519,9.812 7,12.2" />
          <path d="M16,19.926 C16,21.03 15.105,21.926 14,21.926 C12.895,21.926 12,21.03 12,19.926 C12,18.821 12.895,17.926 14,17.926 C15.105,17.926 16,18.821 16,19.926 z" />
          <path class="signal" d="M16.2,4.8 C18.2,6.8 18.46,9.91 17,12.27" />
          <path class="signal" d="M19.1,1.9 C20.972,3.768 22.024,6.305 22.024,8.95 C22.114,11.018 21.236,12.834 20.217,14.566" />
          <path d="M6.8,18.926 L12,18.926" />
          <path d="M12,17.926 L12,6.926" />
          <path d="M12.2,15.542 L17.2,15.542" />
          <path d="M17.2,15.542 L17.2,18.926" />
          <path d="M8.456,18.926 L8.456,21.926" />
        </g>
        <!-- lucide radio-tower, plane: same hand-inlined pattern as index.astro (ISC) -->
        <g id="tower" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path class="signal" d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9" />
          <path class="signal" d="M7.8 4.7a6.14 6.14 0 0 0-.8 7.5" />
          <circle cx="12" cy="9" r="2" />
          <path class="signal" d="M16.2 4.8c2 2 2.26 5.11.8 7.47" />
          <path class="signal" d="M19.1 1.9a9.96 9.96 0 0 1 0 14.1" />
          <path d="M9.5 18h5" />
          <path d="m8 22 4-11 4 11" />
        </g>
        <g id="plane-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
        </g>
        <!-- lucide radio: known mesh nodes. wave arcs carry .signal so --sig can
             gate them per instance (map: always on; diagram: only while keyed) -->
        <g id="mesh-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path class="signal" d="M16.247 7.761a6 6 0 0 1 0 8.478" />
          <path class="signal" d="M19.075 4.933a10 10 0 0 1 0 14.134" />
          <path class="signal" d="M4.925 19.067a10 10 0 0 1 0-14.134" />
          <path class="signal" d="M7.753 16.239a6 6 0 0 1 0-8.478" />
          <circle cx="12" cy="12" r="2" />
        </g>
        <!-- lucide ship: AIS surface contacts -->
        <g id="ship-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 10.189V14" />
          <path d="M12 2v3" />
          <path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6" />
          <path d="M19.38 20A11.6 11.6 0 0 0 21 14l-8.188-3.639a2 2 0 0 0-1.624 0L3 14a11.6 11.6 0 0 0 2.81 7.76" />
          <path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
        </g>
        <!-- lucide bird: an acoustic detection at the node (see the field log) -->
        <g id="bird-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 7h.01" />
          <path d="M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20" />
          <path d="m20 7 2 .5-2 .5" />
          <path d="M10 18v3" />
          <path d="M14 17.75V21" />
          <path d="M7 18a6 6 0 0 0 3.84-10.61" />
        </g>
        <!-- lucide sun: solar-powered marker, shared with the mesh diagram (ISC) -->
        <g id="sun-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" /><path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </g>
        <!-- lucide key-round: exchange-endpoint marker, shared likewise (ISC) -->
        <g id="key-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
          <circle cx="16.5" cy="7.5" r=".5" fill="currentColor" />
        </g>
        <!-- lucide satellite: LEO passes -->
        <g id="sat-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m13.5 6.5-3.148-3.148a1.205 1.205 0 0 0-1.704 0L6.352 5.648a1.205 1.205 0 0 0 0 1.704L9.5 10.5" />
          <path d="M16.5 7.5 19 5" />
          <path d="m17.5 10.5 3.148 3.148a1.205 1.205 0 0 1 0 1.704l-2.296 2.296a1.205 1.205 0 0 1-1.704 0L13.5 14.5" />
          <path d="M9 21a6 6 0 0 0-6-6" />
          <path d="M9.352 10.648a1.205 1.205 0 0 0 0 1.704l2.296 2.296a1.205 1.205 0 0 0 1.704 0l4.296-4.296a1.205 1.205 0 0 0 0-1.704l-2.296-2.296a1.205 1.205 0 0 0-1.704 0z" />
        </g>
      </defs>

      <g class="graticule">
        <line x1="320" y1="0" x2="320" y2="1000" />
        <line x1="640" y1="0" x2="640" y2="1000" />
        <line x1="960" y1="0" x2="960" y2="1000" />
        <line x1="1280" y1="0" x2="1280" y2="1000" />
        <line x1="0" y1="250" x2="1600" y2="250" />
        <line x1="0" y1="500" x2="1600" y2="500" />
        <line x1="0" y1="750" x2="1600" y2="750" />
        <!-- graticule crossings carry blank coordinate ticks: the node's location stays unstated -->
        <g class="tick"><rect x="574" y="482" width="36" height="13" /><text x="616" y="493">N</text></g>
        <g class="tick"><rect x="968" y="248" width="36" height="13" /><text x="1010" y="259">W</text></g>
      </g>

      <g class="contours">
        {contours.map((c) => <path d={c.d} class:list={[c.level % 200 === 0 && 'index']} />)}
      </g>
      <g class="coast">
        {coast.map((d) => (
          <>
            <path class="shore-glow" d={d} />
            <path class="shore" d={d} />
          </>
        ))}
      </g>
      <text class="sea-label" x="150" y="800">OPEN WATER</text>

      <!-- standing mesh topology, same channel coding as the diagram below -->
      {mapMeshLinks.map((l) => (
        <line class={l.priv ? 'priv-link' : 'pub-link'} x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />
      ))}

      <!-- outbound fronts from the node: one fired per received beacon, pooled so
           overlapping replies coexist -->
      {Array.from({ length: 5 }).map(() => <circle class="wave" cx="640" cy="420" r="1200" />)}

      <!-- beacon ring pool: the script parks one at an emitter's current position, so
           the epicenter stays put while the vehicle moves on -->
      {Array.from({ length: 8 }).map(() => <circle class="ring" cx="0" cy="0" r="0" />)}

      <!-- other radio stations on the air: each darkens and raises its wave
           marks while it transmits (staggered by --pd) -->
      <g class="peer" style="--pd: 0s">
        <svg x="745" y="685" width="30" height="30" viewBox="0 0 24 24" class="glyph"><use href="#tower" /></svg>
        <text class="tag" x="784" y="705">STN-01</text>
      </g>
      <g class="peer" style="--pd: 3s">
