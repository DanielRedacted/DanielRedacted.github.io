---
import Base from '../layouts/Base.astro';
import LoadSequence from '../components/LoadSequence.astro';
import { QUOTES } from '../data/quotes.js';
import { READER } from '../data/prayers.js';

// Business card brick, ink on paper (global.css "Brick"). One card holds the whole homepage:
// who, work, pages, reach. On load, after a beat, labels type in while everything else fades in;
// same-tab links play it in reverse (LoadSequence). Copy only repeats what the site already says.
// The miniature RSVP reader flashes Franklin's Lord's Prayer one word at a time on repeat (the
// Aramaic and the Gospel prayers are on hold in prayers.js), each word's pivot letter in red on a
// fixed guide, with a Latin cross (✝) to its left. Data in src/data/prayers.js, script at the bottom. The .rsvp-static
// paragraphs are what screen readers, no-JS and reduced-motion visitors get.
const BEAT = 500; // ms of empty screen before anything appears
const WPM = 600;

// LinkedIn + GitHub only: the other handles stay off until the handle question is settled.
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/danielredacted/',
    d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z' },
  { label: 'GitHub', href: 'https://github.com/DanielRedacted',
    d: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
];

// Icons render as ink silhouettes through a CSS mask (.org-icon), whatever their source colors.
const work = [
  { label: 'AP0110', href: 'https://AP0110.org', icon: '/images/ap0110-logo.svg', mono: true },
  { label: 'CalCompute', href: 'https://CaliforniaCompute.org', icon: '/images/calcompute-icon.svg' },
  { label: 'Life Impact International', href: 'https://lifeimpactintl.org', icon: '/images/lii-icon-ink.png' },
];
---

<Base>
  <main data-beat={BEAT} class="brick-main">
    <div class="brick">
      {/* Row 1. Left: photo, name, field, the line I stand by. Right: the schools. */}
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-3">
          <img src="/images/avatar.jpg" alt="Daniel Romo" width="56" height="56" class="avatar-sm fade" />
          <div class="flex flex-col gap-1">
            <h1 data-type>Daniel Romo</h1>
            <p data-type class="micro ink-mid">Mechanical engineer</p>
          </div>
        </div>
        <p data-type class="font-mono text-[12px] leading-[1.6] tracking-[.02em] ink-mid">On a quest to build digital independence for myself and others.</p>
      </div>

      <div class="flex items-center gap-3 self-start min-[680px]:justify-end fade">
        <img src="/images/ucr-wordmark.png" alt="UC Riverside" class="alma" />
        <img src="/images/ucberkeley-wordmark.png" alt="UC Berkeley" class="alma" />
      </div>

      {/* Hero quote, full width. The inline script swaps in this load's pick before LoadSequence reads
           the citation, so the citation types in; the quote itself fades (too long to type). */}
      <figure class="col-span-full flex flex-col gap-1 m-0">
        <blockquote id="quote" class="font-mono text-[12px] leading-[1.6] tracking-[.02em] ink m-0 fade">&ldquo;{QUOTES[0].q}&rdquo;</blockquote>
        {/* the English, on its own line, when the quote is in another language */}
        <p id="quote-en" hidden={!QUOTES[0].en} class="font-mono text-[12px] leading-[1.6] tracking-[.02em] ink-mid fade">{QUOTES[0].en}</p>
        <figcaption id="quote-cite" data-type class="fine ink-low">{QUOTES[0].cite}</figcaption>
      </figure>
      <script is:inline define:vars={{ QUOTES }}>
        var x = QUOTES[Math.floor(Math.random() * QUOTES.length)];
        document.getElementById('quote').textContent = '\u201C' + x.q + '\u201D';
        var en = document.getElementById('quote-en');
        en.textContent = x.en || '';
        en.hidden = !x.en;
        document.getElementById('quote-cite').textContent = x.cite;
      </script>

      {/* Row 2: work (out to each org). */}
      <nav aria-label="Work" class="col-span-full flex flex-col gap-2">
        {work.map((w) => {
          const out = w.href.startsWith('http');
          return (
            <a href={w.href} target={out ? '_blank' : undefined} rel={out ? 'noopener' : undefined}
              class:list={['micro ink-mid self-start flex items-center gap-2', { mono: w.mono }]}>
              <span class="org-icon fade" style={`--m:url(${w.icon})`} aria-hidden="true"></span>
              <span data-type>{w.label}{out ? ' \u2197' : ''}</span>
            </a>
          );
        })}
      </nav>
      {/* Site pages temporarily hidden (pages still build). To restore, drop col-span-full from Work and add:
           <nav aria-label="Site" class="grid grid-cols-2 gap-2 content-start">
             <a href="/compute/" class="ctl fade"><span data-type>Compute</span></a>
             <a href="/garage/" class="ctl fade"><span data-type>Garage</span></a>
           </nav> */}

      {/* Row 3. Left: socials, the legal line. Right: the reader, in the bottom-right corner. */}
      <div class="flex flex-col gap-2 justify-end">
        <div class="flex items-center gap-2 fade">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="social">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-full h-full"><path d={s.d} /></svg>
            </a>
          ))}
          {/* Opens the contact section below the card (a disclosure, like AP0110.com's FAQ). */}
          <button type="button" aria-controls="contact" aria-expanded="false" aria-label="Contact me" data-js-only class="social cursor-pointer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-full h-full">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </button>
        </div>
        <p data-type class="fine ink-low pt-2">&copy; 2026 DANIEL ROMO</p>
      </div>
      <figure class="rsvp fade self-start min-[680px]:justify-self-end" data-wpm={WPM} data-start={BEAT + 800} data-prayers={JSON.stringify(READER)}>
        <div class="flex items-center gap-2">
          {/* Latin cross (U+271D) left of the reader; U+FE0E asks for the text glyph, never the emoji */}
          <span class="rsvp-cross" aria-hidden="true">&#x271D;&#xFE0E;</span>
          <div class="rsvp-box" aria-hidden="true"><span class="rsvp-a"></span><span class="rsvp-p"></span><span class="rsvp-b"></span></div>
        </div>
        {READER.map((r) => <p lang={r.lang} class="rsvp-static font-mono text-[12px] leading-[1.6] tracking-[.02em] ink-mid whitespace-pre-line">{r.text}</p>)}
      </figure>

      {/* Contact: full width, hung below the card (global.css, #contact) so opening it never moves
           the centered card; collapsed behind "Contact me" (open without JS).
           Native POST, zero JS: functions/api/form.js stores it in D1 and 303s back to /#sent. */}
      <section id="contact" aria-labelledby="contact-title" class="disclose col-span-full flex flex-col gap-3">
        <h2 id="contact-title" data-type class="micro ink">Contact me</h2>
        <form action="/api/form" method="post" class="flex flex-col gap-3">
          <input type="hidden" name="form" value="contact" />
          {/* Honeypot: hidden from people and assistive tech; bots fill it and get dropped. */}
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />
          <div class="flex flex-col gap-1">
            <label for="subject" data-type class="micro ink-mid">Subject</label>
            <input id="subject" name="subject" type="text" maxlength="200" placeholder="Optional" class="ctl ctl-input fade" />
          </div>
          <div class="flex flex-col gap-1">
            <label for="message" data-type class="micro ink-mid">Message *</label>
            <textarea id="message" name="message" rows="4" required maxlength="5000" placeholder="What's on your mind" class="ctl ctl-input ctl-area fade"></textarea>
          </div>
          <div class="flex flex-col gap-1">
            <label for="email" data-type class="micro ink-mid">Reply to *</label>
            <input id="email" name="email" type="email" required autocomplete="email" pattern="[^@ ]+@[^@ ]+[.][^@ ]+" placeholder="you@example.com" class="ctl ctl-input fade" />
          </div>
          {/* Inverts once every required field is valid (global.css, form:valid > .ctl-send). */}
          <button type="submit" class="ctl ctl-send fade mt-2 cursor-pointer"><span data-type>Send</span></button>
          <p id="sent" role="status" class="fine ink-mid">Sent. Thank you, I'll reply by email.</p>
        </form>
      </section>
      {/* Arriving at /#contact (old /invite links) or /#sent (after a send): start open. */}
      <script is:inline>
        if (location.hash === '#contact' || location.hash === '#sent') {
          document.getElementById('contact').classList.add('open');
          document.querySelector('[aria-controls="contact"]').setAttribute('aria-expanded', 'true');
        }
      </script>
    </div>
  </main>
  <LoadSequence />
</Base>

<script>
  // The open contact section ends as far above the page bottom as the centered card starts below the
  // window top (global.css, --below). The section hangs out of flow, so it never moves the card.
  const card = document.querySelector<HTMLElement>('.brick')!;
  const below = () => card.style.setProperty('--below', `${card.getBoundingClientRect().top + scrollY}px`);
  new ResizeObserver(below).observe(card); // runs once now, again as fonts land and the card reflows
  addEventListener('resize', below); // the viewport height moves the centered card too
</script>

<script>
  // RSVP reader: one word at a time, its pivot (optimal recognition point) letter in red under the
  // guide ticks, at data-wpm; commas, stops, line ends and long words hold longer. It alternates the
  // prayers in data-prayers, starting with a random one. The window is sized to the longest run
  // either side of the pivot across all of them (--a, --b).
  // Reduced motion and no-JS: CSS shows .rsvp-static instead and this does nothing.
  // ponytail: one setTimeout chain, no play/pause; add a control if anyone wants to stop it.
  const fig = document.querySelector<HTMLElement>('.rsvp');
  if (fig && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const [a, p, b] = fig.querySelectorAll<HTMLElement>('.rsvp-box span');
    const box = fig.querySelector<HTMLElement>('.rsvp-box')!;
    // Letters are grapheme clusters, so a combining mark (the macron in p̄) stays on its letter.
    const letters = (w: string) => w.match(/\P{M}\p{M}*/gu) || [];
    const pivot = (w: string) => {
      const l = letters(w), n = letters(w.replace(/[^\p{L}\p{M}]+$/u, '')).length;
      let k = n <= 1 ? 0 : n <= 5 ? 1 : n <= 9 ? 2 : n <= 13 ? 3 : 4;
      while (k < l.length - 1 && !/^\p{L}/u.test(l[k])) k++; // never pivot on a hyphen (w-lā)
      return k;
    };
    // Each prayer as words; the last word of each line (each Aramaic petition) holds like a full stop.
    type Word = { w: string; end: boolean };
    const prayers = (JSON.parse(fig.dataset.prayers || '[]') as { lang: string; text: string }[]).map((r) => ({
      syc: r.lang.startsWith('syc'),
      words: r.text.split('\n').flatMap((line) => line.trim().split(/\s+/).map((w, i, all): Word => ({ w, end: i === all.length - 1 }))),
    }));
    const all = prayers.flatMap((x) => x.words.map((x) => x.w));
    box.style.setProperty('--a', String(Math.max(...all.map(pivot))));
    box.style.setProperty('--b', String(Math.max(...all.map((w) => letters(w).length - pivot(w) - 1))));
    const base = 60000 / Number(fig.dataset.wpm || 250);
    const hold = ({ w, end }: Word) => (end || /[.;:?!]$/.test(w) ? 2.5 : /,$/.test(w) ? 1.8 : 1) * (letters(w).length > 8 ? 1.3 : 1);
    let n = Math.floor(Math.random() * prayers.length), i = 0; // which prayer, which word
    const tick = () => {
      const cur = prayers[n], word = cur.words[i], l = letters(word.w), k = pivot(word.w);
      box.classList.toggle('syc', cur.syc);
      a.textContent = l.slice(0, k).join(''); p.textContent = l[k]; b.textContent = l.slice(k + 1).join('');
      if (++i === cur.words.length) { i = 0; n = (n + 1) % prayers.length; } // then straight into the other one
      setTimeout(tick, base * hold(word));
    };
    setTimeout(tick, Number(fig.dataset.start) || 0);
  }
</script>
