---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daniel Romo',
  description =
    'Helping You take advantage of the internet and prevent the internet from taking advantage of you.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/avatar.jpg', Astro.site)} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    {/* no header on the homepage: the hero carries the name, and the cloud
        banner runs clear to the top of the page */}
    {path !== '/' && (
      <header>
        <div class="bar w-full">
          <a href="/" class="sigil" aria-label="Daniel Romo, home">
            <span class="wordmark">Daniel Romo</span>
          </a>
          {/* topnav temporarily hidden with every page it listed (library, lii, compute, garage);
               the pages still build. To restore, map the names back in:
               <nav class="topnav" aria-label="Site">{['lii', 'compute', 'garage'].map((p) => (
                 <a href={`/${p}/`} class="label" aria-current={path.startsWith(`/${p}`) ? 'page' : undefined}>{p}</a>))}</nav> */}
        </div>
      </header>
    )}

    <slot />
  </body>
</html>
